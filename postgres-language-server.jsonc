{
  "$schema": "https://pg-language-server.com/latest/schema.json",
  "db": {
    "host": "localhost",
    "username": "postgres",
    "password": "postgres",
    "port": 5432,
    "database": "recipes",
    "allowStatementExecutionsAgainst": ["public"],
  },
  "linter": {
    "rules": {
      "safety": {
        "banConcurrentIndexCreationInTransaction": "off",
      },
    },
  },
  "format": {
    "enabled": true,
    "constantCase": "upper",
    "keywordCase": "upper",
    "typeCase": "upper",
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "defaultBranch": "main",
    "useIgnoreFile": true,
  },
}
