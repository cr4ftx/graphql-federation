{
	"type": "module",
	"scripts": {
		"compose": "node compose.ts",
		"compose:watch": "node --watch --watch-path=./nestjs-app/users.graphql --watch-path=./fastify-yoga/recipe.graphql compose.ts",
		"predev": "pnpm compose",
		"dev": "concurrently pnpm:dev:nestjs pnpm:dev:fastify pnpm:hive",
		"hive": "docker compose up",
		"dev:nestjs": "pnpm -C nestjs-app start:dev",
		"dev:fastify": "pnpm -C fastify-yoga dev",
		"test:load": "gatling run"
	},
	"devDependencies": {
		"@apollo/composition": "2.11.3",
		"@gatling.io/cli": "3.14.905",
		"@gatling.io/core": "3.14.905",
		"@gatling.io/http": "3.14.905",
		"@theguild/federation-composition": "0.20.2",
		"@types/node": "24.9.2",
		"concurrently": "9.2.1",
		"graphql": "16.11.0"
	}
}
